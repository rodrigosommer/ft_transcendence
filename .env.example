# Copied to .env by 'make' (tools/scripts/gen-env.sh), which replaces the four
# generated values below with fresh random ones. Never commit the resulting .env.

# Host port for the HTTPS edge.
WEB_PORT=8443

# The address browsers use. OAuth redirect URIs and cookie scope are built from it.
PUBLIC_ORIGIN=https://localhost:8443
# Other addresses the same deployment answers on, comma separated.
PUBLIC_ORIGIN_ALIASES=

NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info

# Database. The password and DATABASE_URL are generated; keep the two in step if
# you edit them by hand.
POSTGRES_USER=wkb
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=wkb
DATABASE_URL=postgresql://wkb:change_me_db_password@postgres:5432/wkb?schema=public

# Generated. At least 32 characters each.
JWT_ACCESS_SECRET=replace_with_a_random_secret
JWT_REFRESH_SECRET=replace_with_a_random_secret
# Lifetimes, in seconds.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ada@, grace@ and alan@wkb.local, password Password1!. Fine for a local run or
# an evaluation, unsafe on anything reachable from the internet.
SEED_DEMO_USERS=true

# OAuth sign in, all optional: a provider's button is hidden while it is unset.
# Callback: ${PUBLIC_ORIGIN}/api/auth/oauth/<google|github|42>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 42 intra. 'FT_' because a variable name cannot start with a digit.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Not needed to run the game. Only used to rebuild the card set.
ANTHROPIC_API_KEY=
